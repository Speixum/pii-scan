{
  "schema": "pii-rules/1.0",
  "name": "builtin",
  "version": "1.0",
  "rules": [
    {
      "name": "cn_id_card",
      "type": "cn_id_card",
      "regex": "(?<![0-9A-Za-z_])\\d{17}[0-9Xx](?![0-9A-Za-z_])",
      "validators": [
        "cn_id_card"
      ],
      "context_keywords": [
        "身份证",
        "证件号",
        "公民身份号码",
        "id card",
        "idcard",
        "id_card"
      ],
      "weight": 0.55,
      "level": "high_sensitive",
      "preview": "head4_tail4"
    },
    {
      "name": "bank_card",
      "type": "bank_card",
      "regex": "(?<![0-9])\\d{16,19}(?![0-9])",
      "validators": [
        "luhn"
      ],
      "context_keywords": [
        "卡号",
        "银行卡",
        "信用卡",
        "储蓄卡",
        "card",
        "account"
      ],
      "weight": 0.5,
      "level": "high_sensitive",
      "preview": "head4_tail4"
    },
    {
      "name": "mobile_cn",
      "type": "mobile_cn",
      "regex": "(?<![0-9])1[3-9][0-9]{9}(?![0-9])",
      "validators": [
        "mobile_cn"
      ],
      "context_keywords": [
        "手机",
        "电话",
        "联系方式",
        "手机号",
        "mobile",
        "phone",
        "tel"
      ],
      "weight": 0.5,
      "level": "sensitive",
      "preview": "head3_tail4"
    },
    {
      "name": "email",
      "type": "email",
      "regex": "(?<![A-Za-z0-9._%+-])[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)*\\.[A-Za-z]{2,24}(?![A-Za-z0-9.-])",
      "validators": [
        "email"
      ],
      "context_keywords": [
        "邮箱",
        "邮件",
        "电子邮箱",
        "email",
        "mail"
      ],
      "weight": 0.5,
      "level": "sensitive",
      "preview": "email"
    },
    {
      "name": "uscc",
      "type": "uscc",
      "regex": "(?<![0-9A-Z])[0-9A-HJ-NPQRTUWXY]{18}(?![0-9A-Z])",
      "validators": [
        "uscc"
      ],
      "context_keywords": [
        "统一社会信用代码",
        "信用代码",
        "uscc"
      ],
      "weight": 0.5,
      "level": "sensitive",
      "preview": "head4_tail4"
    },
    {
      "name": "ipv4",
      "type": "ipv4",
      "regex": "(?<![0-9.])(?:[0-9]{1,3}\\.){3}[0-9]{1,3}(?![0-9.])",
      "validators": [
        "ipv4"
      ],
      "context_keywords": [
        "ip",
        "地址",
        "服务器",
        "网关",
        "host"
      ],
      "weight": 0.4,
      "level": "general",
      "preview": "ipv4"
    }
  ]
}
